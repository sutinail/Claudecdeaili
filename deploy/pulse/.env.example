# 脉 · Pulse 配置
PULSE_SECRET=your-secret-here
PULSE_PORT=8300
# MCP 连接器密码，claude.ai 里的地址写成 https://pulse-mcp.gpt1126.top/sse?key=这个值
PULSE_MCP_KEY=your-mcp-key-here
# 时区偏移（小时），北京时间 8
PULSE_TZ_OFFSET=8
# 天气坐标（Open-Meteo，免费不用 key）；不填就停在默认 25°C 晴
PULSE_WEATHER_LAT=
PULSE_WEATHER_LON=
# 硅基流动 API Key：语料按意思匹配（BAAI/bge-m3，免费）；不填就只用关键词匹配
SILICONFLOW_API_KEY=
# 实时数据目录（语料池、心率历史）。留空就用仓库里的 ./data
PULSE_DATA_DIR=
