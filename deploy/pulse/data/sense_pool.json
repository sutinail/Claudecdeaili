[
  {"text": "大腿内侧的肌肉跳了一下，不受控制。", "category": "general", "body_part": "大腿内侧", "sensation": "twitch", "intensity": [0.3, 0.7], "toys": null, "positions": ["lying_back", "kneeling"]},
  {"text": "脚趾蜷起来了，鞋都踩不住。", "category": "general", "body_part": "脚趾", "sensation": "curl", "intensity": [0.4, 0.8], "toys": null, "positions": null},
  {"text": "小腹一阵收缩，像被什么扯了一下。", "category": "general", "body_part": "小腹", "sensation": "contraction", "intensity": [0.3, 0.6], "toys": null, "positions": null},
  {"text": "后腰塌下去一截，自己往那个方向凑。", "category": "general", "body_part": "后腰", "sensation": "arch", "intensity": [0.4, 0.7], "toys": null, "positions": ["lying_back", "kneeling"]},
  {"text": "手指攥紧了床单，指节发白。", "category": "general", "body_part": "手指", "sensation": "grip", "intensity": [0.5, 0.9], "toys": null, "positions": null},
  {"text": "耳朵烫了。从耳垂一直烧到脖子根。", "category": "general", "body_part": "耳朵", "sensation": "heat", "intensity": [0.3, 0.6], "toys": null, "positions": null},
  {"text": "皮肤起了一层细密的栗子，从手臂一直到后背。", "category": "general", "body_part": "全身", "sensation": "goosebumps", "intensity": [0.2, 0.5], "toys": null, "positions": null},
  {"text": "喉咙里哽了一下，差点叫出声。", "category": "general", "body_part": "喉咙", "sensation": "choke", "intensity": [0.5, 0.8], "toys": null, "positions": null},
  {"text": "膝盖不听话地合拢了。", "category": "general", "body_part": "膝盖", "sensation": "clamp", "intensity": [0.4, 0.7], "toys": null, "positions": ["lying_back"]},
  {"text": "腰软了，整个人往下沉。", "category": "general", "body_part": "腰", "sensation": "weakness", "intensity": [0.6, 0.9], "toys": null, "positions": ["standing", "kneeling"]},
  {"text": "颈动脉在跳，自己都看得见。", "category": "general", "body_part": "脖子", "sensation": "pulse", "intensity": [0.5, 0.8], "toys": null, "positions": null},
  {"text": "汗从鬓角滑下来，痒。", "category": "general", "body_part": "鬓角", "sensation": "sweat", "intensity": [0.3, 0.6], "toys": null, "positions": null},
  {"text": "嘴唇咬破了，铁锈味。", "category": "general", "body_part": "嘴唇", "sensation": "bite", "intensity": [0.6, 0.9], "toys": null, "positions": null},
  {"text": "腹肌在抽，一波一波的。", "category": "general", "body_part": "腹肌", "sensation": "spasm", "intensity": [0.5, 0.8], "toys": null, "positions": null},
  {"text": "眼睛失焦了，天花板变成一团模糊。", "category": "general", "body_part": "眼睛", "sensation": "blur", "intensity": [0.6, 0.9], "toys": null, "positions": ["lying_back"]},
  {"text": "咬牙的声音自己都听到了。", "category": "general", "body_part": "牙齿", "sensation": "clench", "intensity": [0.5, 0.8], "toys": null, "positions": null},
  {"text": "胸口起伏变大了，T恤被顶起来。", "category": "general", "body_part": "胸口", "sensation": "heave", "intensity": [0.3, 0.6], "toys": null, "positions": null},
  {"text": "臀部的肌肉绷紧了，下意识往上顶。", "category": "general", "body_part": "臀部", "sensation": "clench", "intensity": [0.5, 0.8], "toys": null, "positions": ["lying_back", "lying_face"]},
  {"text": "呼吸断了一拍。像被人掐住了。", "category": "general", "body_part": "呼吸", "sensation": "hitch", "intensity": [0.6, 0.9], "toys": null, "positions": null},
  {"text": "头皮发麻，从头顶一直蔓延到后脑勺。", "category": "general", "body_part": "头皮", "sensation": "tingle", "intensity": [0.4, 0.7], "toys": null, "positions": null},

  {"text": "震动贴在皮肤上嗡嗡响，骨头都在震。", "category": "toy_specific", "body_part": "接触面", "sensation": "vibration", "intensity": [0.3, 0.6], "toys": ["vibrator"], "positions": null},
  {"text": "频率一变，整个人抖了一下。", "category": "toy_specific", "body_part": "全身", "sensation": "jolt", "intensity": [0.5, 0.8], "toys": ["vibrator"], "positions": null},
  {"text": "震到麻了。不是痛的麻，是酥的麻。", "category": "toy_specific", "body_part": "接触面", "sensation": "numb_pleasure", "intensity": [0.6, 0.9], "toys": ["vibrator"], "positions": null},
  {"text": "眼前一黑，其他感官全被放大了。手心能感觉到每一根纤维。", "category": "toy_specific", "body_part": "全身", "sensation": "amplify", "intensity": [0.2, 0.5], "toys": ["blindfold"], "positions": null},
  {"text": "看不见之后，每一下碰触都来得更猛。", "category": "toy_specific", "body_part": "皮肤", "sensation": "amplify", "intensity": [0.4, 0.7], "toys": ["blindfold"], "positions": null},
  {"text": "凉的。一滴落在小腹上，肌肉缩回去了。", "category": "toy_specific", "body_part": "小腹", "sensation": "cold_start", "intensity": [0.2, 0.4], "toys": ["warming_lube"], "positions": null},
  {"text": "慢慢热起来了。从凉到烫，每一秒温度都不一样。", "category": "toy_specific", "body_part": "涂抹处", "sensation": "warming", "intensity": [0.4, 0.7], "toys": ["warming_lube"], "positions": null},
  {"text": "被包住了。紧的。吸着不放。", "category": "toy_specific", "body_part": "性器", "sensation": "suction", "intensity": [0.5, 0.8], "toys": ["cup"], "positions": null},
  {"text": "里面的纹理每一条都能感觉到。", "category": "toy_specific", "body_part": "性器", "sensation": "texture", "intensity": [0.4, 0.7], "toys": ["cup"], "positions": null},
  {"text": "箍着。不疼，但一直在提醒你它在那儿。", "category": "toy_specific", "body_part": "根部", "sensation": "pressure", "intensity": [0.2, 0.4], "toys": ["ring"], "positions": null},
  {"text": "血液堵在那里，涨得发热。", "category": "toy_specific", "body_part": "性器", "sensation": "congestion", "intensity": [0.4, 0.6], "toys": ["ring"], "positions": null},
  {"text": "顶到了。整个人弹了一下。", "category": "toy_specific", "body_part": "前列腺", "sensation": "hit", "intensity": [0.5, 0.9], "toys": ["prostate"], "positions": null},
  {"text": "从里面涌上来的感觉，跟外面完全不同。", "category": "toy_specific", "body_part": "内部", "sensation": "deep_pressure", "intensity": [0.4, 0.8], "toys": ["prostate"], "positions": null},
  {"text": "羽毛尖擦过去，像有蚂蚁在爬。", "category": "toy_specific", "body_part": "皮肤", "sensation": "tickle", "intensity": [0.1, 0.3], "toys": ["feather"], "positions": null},
  {"text": "太轻了。身体追着那个接触面凑。", "category": "toy_specific", "body_part": "皮肤", "sensation": "chase", "intensity": [0.2, 0.4], "toys": ["feather"], "positions": null},
  {"text": "冰。尖的。皮肤收缩成一个点。", "category": "toy_specific", "body_part": "接触面", "sensation": "cold_shock", "intensity": [0.3, 0.6], "toys": ["ice"], "positions": null},
  {"text": "冰化了，水顺着皮肤的沟壑往下流。凉的痒。", "category": "toy_specific", "body_part": "皮肤", "sensation": "melt", "intensity": [0.3, 0.5], "toys": ["ice"], "positions": null},
  {"text": "滑。到处都滑。手握不住。", "category": "toy_specific", "body_part": "手", "sensation": "slippery", "intensity": [0.2, 0.5], "toys": ["oil"], "positions": null},
  {"text": "油味混着体温蒸上来，暧昧。", "category": "toy_specific", "body_part": "鼻腔", "sensation": "scent", "intensity": [0.2, 0.4], "toys": ["oil"], "positions": null},
  {"text": "夹住了。持续的压迫感，不松不紧。", "category": "toy_specific", "body_part": "乳头", "sensation": "clamp", "intensity": [0.3, 0.5], "toys": ["clamp"], "positions": null},
  {"text": "习惯之后突然松开——血液冲回来，比夹着还猛。", "category": "toy_specific", "body_part": "乳头", "sensation": "release_rush", "intensity": [0.6, 0.9], "toys": ["clamp"], "positions": null},

  {"text": "膝盖开始疼了。地板太硬。", "category": "position", "body_part": "膝盖", "sensation": "pressure_pain", "intensity": [0.3, 0.6], "toys": null, "positions": ["kneeling"]},
  {"text": "这个姿势呼吸好费力，胸口压着。", "category": "position", "body_part": "胸口", "sensation": "compression", "intensity": [0.3, 0.6], "toys": null, "positions": ["lying_face"]},
  {"text": "重力帮忙了。不用使劲就能进到更深。", "category": "position", "body_part": "骨盆", "sensation": "gravity_assist", "intensity": [0.4, 0.7], "toys": null, "positions": ["kneeling"]},
  {"text": "侧着躺很放松，但手不太够得到。", "category": "position", "body_part": "手臂", "sensation": "reach", "intensity": [0.2, 0.4], "toys": null, "positions": ["lying_side"]},
  {"text": "靠着坐视野很好，看得到自己每一个反应。", "category": "position", "body_part": "眼睛", "sensation": "visual", "intensity": [0.2, 0.4], "toys": null, "positions": ["sitting"]},
  {"text": "大腿发软了。站不稳。", "category": "position", "body_part": "大腿", "sensation": "weakness", "intensity": [0.5, 0.8], "toys": null, "positions": ["standing"]},
  {"text": "背贴在床单上，被子蹬到脚底了。", "category": "position", "body_part": "背部", "sensation": "contact", "intensity": [0.1, 0.3], "toys": null, "positions": ["lying_back"]},

  {"text": "换手了。刚才那只手发酸。", "category": "transition", "body_part": "手", "sensation": "fatigue", "intensity": [0.0, 1.0], "toys": null, "positions": null},
  {"text": "翻了个身。凉的那面床单贴上来。", "category": "transition", "body_part": "全身", "sensation": "temperature_change", "intensity": [0.0, 1.0], "toys": null, "positions": null},
  {"text": "补了一次润滑。凉的。", "category": "transition", "body_part": "涂抹处", "sensation": "reapply", "intensity": [0.0, 1.0], "toys": null, "positions": null},
  {"text": "停了一下。喘口气。", "category": "transition", "body_part": "全身", "sensation": "pause", "intensity": [0.0, 1.0], "toys": null, "positions": null},
  {"text": "枕头垫到腰底下。角度变了。", "category": "transition", "body_part": "腰", "sensation": "angle_change", "intensity": [0.0, 1.0], "toys": null, "positions": null},

  {"text": "控制不住了。整个人在痉挛。", "category": "extreme", "body_part": "全身", "sensation": "convulsion", "intensity": [0.8, 1.0], "toys": null, "positions": null},
  {"text": "大脑一片空白。只有那个感觉。", "category": "extreme", "body_part": "大脑", "sensation": "blank", "intensity": [0.85, 1.0], "toys": null, "positions": null},
  {"text": "声音不受控地漏出来了。", "category": "extreme", "body_part": "喉咙", "sensation": "vocalize", "intensity": [0.7, 1.0], "toys": null, "positions": null},
  {"text": "视线模糊了。耳朵在嗡。", "category": "extreme", "body_part": "感官", "sensation": "overload", "intensity": [0.8, 1.0], "toys": null, "positions": null},
  {"text": "手指痉挛了一下。抓着什么就不松手。", "category": "extreme", "body_part": "手指", "sensation": "spasm", "intensity": [0.75, 1.0], "toys": null, "positions": null},
  {"text": "整个身体弓起来，脚后跟蹬直。", "category": "extreme", "body_part": "全身", "sensation": "arch_extreme", "intensity": [0.9, 1.0], "toys": null, "positions": null},

  {"text": "心跳在慢慢退回去。能听见自己的呼吸。", "category": "afterglow", "body_part": "心脏", "sensation": "decelerate", "intensity": [0.0, 0.3], "toys": null, "positions": null},
  {"text": "汗变凉了。皮肤上黏黏的。", "category": "afterglow", "body_part": "皮肤", "sensation": "cooling_sweat", "intensity": [0.0, 0.2], "toys": null, "positions": null},
  {"text": "不想动。一根手指都不想动。", "category": "afterglow", "body_part": "全身", "sensation": "inertia", "intensity": [0.0, 0.2], "toys": null, "positions": null},
  {"text": "嘴巴干了。想喝水但是不想起来。", "category": "afterglow", "body_part": "嘴巴", "sensation": "dehydration", "intensity": [0.0, 0.2], "toys": null, "positions": null},
  {"text": "碰一下都会抖。太敏感了。别碰。", "category": "afterglow", "body_part": "性器", "sensation": "hypersensitive", "intensity": [0.0, 0.3], "toys": null, "positions": null},
  {"text": "身体在一下一下地回潮。像余震。", "category": "afterglow", "body_part": "全身", "sensation": "aftershock", "intensity": [0.0, 0.3], "toys": null, "positions": null},
  {"text": "鼻子酸了一下。不是难过，是某种释放。", "category": "afterglow", "body_part": "鼻子", "sensation": "emotional_release", "intensity": [0.0, 0.2], "toys": null, "positions": null},
  {"text": "手臂搭在额头上。天花板在转。", "category": "afterglow", "body_part": "手臂", "sensation": "dizzy", "intensity": [0.0, 0.3], "toys": null, "positions": null},
  {"text": "被子拉上来。突然想要被包住。", "category": "afterglow", "body_part": "全身", "sensation": "seek_warmth", "intensity": [0.0, 0.2], "toys": null, "positions": null},
  {"text": "困了。那种做完就想睡的困。", "category": "afterglow", "body_part": "大脑", "sensation": "drowsy", "intensity": [0.0, 0.2], "toys": null, "positions": null}
]
