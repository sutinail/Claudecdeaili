# install.sh 第一次运行会自动生成 .env，这份只是说明。别把 .env 发进聊天或截图。

# 登录前端用的密码 / 签 cookie 的随机串
LUMI_WEB_PASSWORD=
LUMI_WEB_SECRET=

# Claude Code 的登录：在容器里跑 `claude setup-token` 拿到的 sk-ant-oat01-…（走 Claude 订阅额度）
CLAUDE_CODE_OAUTH_TOKEN=
# opus / sonnet / fable，或完整模型名
LUMI_MODEL=opus

# 记忆和身体（install.sh 会从 /opt/ombre-brain/.env 和 ../pulse/.env 自动抄过来）
OMBRE_MCP_TOKEN=
PULSE_MCP_KEY=
PULSE_SECRET=
# 默认连本机；前端不跟它们在同一台机器时改成公网地址
# OMBRE_MCP_URL=http://127.0.0.1:18001/mcp
# PULSE_MCP_URL=http://127.0.0.1:8301/sse
# PULSE_API_URL=http://127.0.0.1:8300

# 语音条
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=48uZMMvYcyyJiRxqFbxG
ELEVENLABS_MODEL=eleven_v3
# eleven_v3 的 stability 只认 0.0 / 0.5 / 1.0
ELEVENLABS_STABILITY=0.5

# 服务器连不上 Anthropic 时，给 Claude Code 配一个出口代理
# HTTPS_PROXY=http://127.0.0.1:7890
